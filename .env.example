# ─────────────────────────────────────────────────────────────────────
#  JARVIS AI Operating System — Environment Configuration Template
#  Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────────

# ── Application Environment ────────────────────────────────────────
APP_NAME=JARVIS AI Operating System
ENV=development                          # development | production
DEBUG=false
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ── Security (REQUIRED — Change before any deployment!) ────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=jarvis_super_secret_jwt_key_change_in_production_min_32_chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440        # 24 hours

# ── Database ───────────────────────────────────────────────────────
# Option A: PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://jarvis_admin:your_password@localhost:5432/jarvis_os
#
# Option B: Docker Compose PostgreSQL (auto-configured)
POSTGRES_USER=jarvis_admin
POSTGRES_PASSWORD=jarvis_secure_password
POSTGRES_DB=jarvis_os
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
#
# Option C: SQLite (development only — used when DATABASE_URL is empty)
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./jarvis_dev.db

# ── Redis (optional — for production session caching) ──────────────
# REDIS_URL=redis://localhost:6379/0

# ── CORS Origins ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ── AI Provider API Keys ───────────────────────────────────────────
# Leave empty to use the built-in MockProvider (works without real API keys)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── AI Routing Behaviour ───────────────────────────────────────────
DEFAULT_PROVIDER=MockProvider           # MockProvider | openai | anthropic | gemini
ENABLE_PROVIDER_FALLBACK=true
ENABLE_STREAMING=true
REQUEST_TIMEOUT=60
MAX_RETRIES=3

# ── Vector Memory Engine ───────────────────────────────────────────
CHROMA_PERSIST_PATH=./chroma_db
CHROMA_COLLECTION_NAME=jarvis_memory
EMBEDDING_PROVIDER=sentence_transformer # sentence_transformer | openai
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
MEMORY_DEFAULT_TOP_K=5

# ── JARVIS Command Center ──────────────────────────────────────────
JARVIS_MAX_SESSION_HISTORY=20
JARVIS_APPROVAL_TIMEOUT_SECONDS=300
JARVIS_MAX_CONCURRENT_EXECUTIONS=5

# ── Feature Flags ──────────────────────────────────────────────────
ENABLE_VOICE_STT=true
ENABLE_VOICE_TTS=true
ENABLE_BROWSER_AUTOMATION=true
ENABLE_DESKTOP_AUTOMATION=false         # Requires pyautogui (Windows/Linux only)

# ── Rate Limiting ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=200                 # requests per minute per IP
