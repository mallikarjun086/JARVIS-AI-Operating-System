# Environment Configuration Template for JARVIS AI OS

# General App Settings
APP_NAME="JARVIS AI Operating System"
ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# Security & Secret Keys
SECRET_KEY="jarvis_super_secret_jwt_key_change_in_production_min_32_chars!"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="jarvis_admin"
POSTGRES_PASSWORD="jarvis_secure_password"
POSTGRES_DB="jarvis_os"
DATABASE_URL="postgresql+asyncpg://jarvis_admin:jarvis_secure_password@localhost:5432/jarvis_os"

# Fallback SQLite DB (used if Postgres is unreachable in local dev)
SQLITE_FALLBACK_URL="sqlite+aiosqlite:///./jarvis_dev.db"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000"
